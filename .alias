# ============================================================================
# SYSTEM INFO
# ============================================================================
# Quick system info
sysinfo() {
    echo "💻 system information:"
    echo "os: $(sw_vers -productName) $(sw_vers -productVersion)"
    echo "uptime: $(uptime | sed 's/.*up \([^,]*\).*/\1/')"
    
    # Get memory info in a more readable format
    local total_mem=$(sysctl -n hw.memsize | awk '{print $1/1024/1024/1024 " GB"}')
    local used_mem=$(vm_stat | awk '
        /Pages active/ { active = $3 }
        /Pages inactive/ { inactive = $3 }
        /Pages speculative/ { speculative = $3 }
        /Pages wired down/ { wired = $4 }
        /Pages occupied by compressor/ { compressed = $5 }
        END {
            gsub(/\.$/, "", active)
            gsub(/\.$/, "", inactive) 
            gsub(/\.$/, "", speculative)
            gsub(/\.$/, "", wired)
            gsub(/\.$/, "", compressed)
            used_pages = active + inactive + speculative + wired + compressed
            used_gb = used_pages * 4096 / 1024 / 1024 / 1024
            printf "%.1f GB", used_gb
        }')
    echo "memory: ${used_mem} used of ${total_mem}"
    echo "disk: $(df -h / | tail -1 | awk '{print $4" free of "$2}')"
}

# Show largest files/directories
big() {
    du -ah "${1:-.}" | sort -rh | head -20
}

devspace() {
    local paths=(
        ~/.cache/devbox
        ~/.local/share/devbox
        /nix
        ~/.npm
        ~/.cargo
        ~/.rustup
        ~/Library/Caches/Homebrew
        ~/Library/Developer/Xcode/DerivedData
        ~/Library/Caches/pip
        ~/Library/Caches/go-build
        ~/go/pkg/mod
    )

    du -sh "${paths[@]}" 2>/dev/null | sort -rh
}

devclean() {
    case "${1:-}" in
        go)
            go clean -cache -testcache
            ;;
        go-all)
            go clean -cache -testcache -modcache
            ;;
        rust)
            if [[ -f Cargo.toml ]]; then
                cargo clean
            else
                echo "devclean rust must be run from a Cargo project"
                return 2
            fi
            ;;
        rust-cache-dry)
            du -sh ~/.cargo/registry ~/.cargo/git ~/.rustup/toolchains 2>/dev/null
            ;;
        rust-targets-dry)
            find "${2:-.}" -type d -name target -prune -exec du -sh {} + 2>/dev/null | sort -rh
            ;;
        rust-targets)
            local root="${2:-.}"
            local targets
            targets=$(find "$root" -type d -name target -prune -print 2>/dev/null)
            if [[ -z "$targets" ]]; then
                echo "no Rust target directories found under $root"
                return 0
            fi
            echo "$targets"
            echo "This removes every target/ directory listed above."
            printf "Continue? [y/N] "
            read -r answer
            case "$answer" in
                [Yy]|[Yy][Ee][Ss])
                    echo "$targets" | while read -r dir; do
                        rm -rf "$dir"
                    done
                    ;;
                *)
                    echo "cancelled"
                    return 1
                    ;;
            esac
            ;;
        rust-cache)
            echo "This removes Cargo's global registry/git caches."
            echo "Crates will be downloaded again when builds need them."
            printf "Continue? [y/N] "
            read -r answer
            case "$answer" in
                [Yy]|[Yy][Ee][Ss])
                    rm -rf ~/.cargo/registry/cache ~/.cargo/registry/src ~/.cargo/git/checkouts ~/.cargo/git/db
                    ;;
                *)
                    echo "cancelled"
                    return 1
                    ;;
            esac
            ;;
        nix-dry)
            nix store gc --dry-run
            ;;
        nix)
            nix store gc
            ;;
        npm)
            npm cache verify && npm cache clean --force
            ;;
        *)
            echo "usage: devclean {go|go-all|rust|rust-cache-dry|rust-targets-dry|rust-targets|rust-cache|nix-dry|nix|npm}"
            echo "  go      - clear Go build/test cache"
            echo "  go-all  - clear Go build/test cache and module downloads"
            echo "  rust    - run cargo clean in the current project"
            echo "  rust-cache-dry - show global Cargo/Rust cache sizes"
            echo "  rust-targets-dry [root] - show target/ directories under root"
            echo "  rust-targets [root]     - remove target/ directories under root"
            echo "  rust-cache     - clear global Cargo registry/git caches"
            echo "  nix-dry - show what Nix garbage collection would remove"
            echo "  nix     - run Nix garbage collection"
            echo "  npm     - verify and clear npm cache"
            return 2
            ;;
    esac
}

memtop() {
    ps -Ao pid,%cpu,%mem,rss,comm | sort -nrk4 | head -30
}

agenttop() {
    ps -Ao pid,%cpu,%mem,rss,comm |
        awk 'NR == 1 || $5 ~ /(claude|codex|opencode|treehouse|node|npm|chrome-devtools-mcp)/' |
        sort -nrk4 |
        head -40
}

