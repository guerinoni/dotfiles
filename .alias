# ============================================================================
# NETWORK MONITORING FUNCTIONS
# ============================================================================
_listening_filter() {
    local pattern="$1"
    awk -v pattern="$pattern" '
        BEGIN {
            needle = tolower(pattern)
            found = 0
        }
        NR == 1 {
            header = $0
            next
        }
        index(tolower($0), needle) {
            if (!found) {
                print header
            }
            print
            found = 1
        }
        END {
            exit found ? 0 : 1
        }
    '
}

listening() {
    if [ $# -eq 0 ]; then
        echo "🔍 showing all listening TCP ports:"
        sudo lsof -iTCP -sTCP:LISTEN -n -P
    elif [ $# -eq 1 ]; then
        echo "🔍 searching for TCP ports matching '$1':"
        if ! sudo lsof -iTCP -sTCP:LISTEN -n -P | _listening_filter "$1"; then
            echo "no listening TCP ports matched '$1'"
            return 1
        fi
    else
        echo "usage: listening [pattern]"
        echo "  listening        - show all listening TCP ports"
        echo "  listening 3000   - show processes listening on port 3000"
        return 2
    fi
}

listening_udp() {
    if [ $# -eq 0 ]; then
        echo "🔍 showing all UDP connections:"
        sudo lsof -iUDP -n -P
    elif [ $# -eq 1 ]; then
        echo "🔍 searching for UDP connections matching '$1':"
        if ! sudo lsof -iUDP -n -P | _listening_filter "$1"; then
            echo "no UDP connections matched '$1'"
            return 1
        fi
    else
        echo "usage: listening_udp [pattern]"
        echo "  listening_udp        - show all UDP connections"
        echo "  listening_udp 53     - show UDP processes on port 53"
        return 2
    fi
}

# Show what's using a specific port
port() {
    if [ $# -eq 1 ]; then
        echo "🔍 checking what's using port $1:"
        sudo lsof -i ":$1"
    else
        echo "usage: port <port_number>"
    fi
}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================
# Quick directory creation and navigation
mkcd() {
    if [ $# -eq 1 ]; then
        mkdir -p "$1" && cd "$1"
        echo "📁 created and entered directory: $1"
    else
        echo "usage: mkcd <directory_name>"
    fi
}

# Extract various archive formats
extract() {
    if [ $# -eq 1 ]; then
        if [ -f "$1" ]; then
            echo "📦 extracting $1..."
            # bsdtar sniffs the compression itself, so every tarball shape goes
            # through one branch. The old *.xz arm fed foo.tar.xz to unxz and
            # left a bare .tar sitting there.
            case $1 in
                *.tar|*.tar.*|*.tbz2|*.tgz|*.txz|*.tzst)  tar xf "$1"      ;;
                *.zip)                                    unzip "$1"       ;;
                *.7z)                                     7z x "$1"        ;;
                *.bz2)                                    bunzip2 "$1"     ;;
                *.gz)                                     gunzip "$1"      ;;
                *.xz)                                     unxz "$1"        ;;
                *.zst)                                    unzstd "$1"      ;;
                *.lzma)                                   unlzma "$1"      ;;
                *.Z)                                      uncompress "$1"  ;;
                *) echo "❌ '$1' cannot be extracted (unsupported format)" ;;
            esac
            echo "✅ extraction complete"
        else
            echo "❌ '$1' is not a valid file"
        fi
    else
        echo "usage: extract <archive_file>"
    fi
}


