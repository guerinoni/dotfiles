[user]
	name = Federico Guerinoni
	email = guerinoni.federico@gmail.com
	signingkey = C64FEC6274394E79829F857C6C17FCC1A3C0A699

[core]
	pager = delta
	editor = nvim
	ignorecase = false
	excludesFile = ~/.gitignore_global
	fsmonitor = false     # enable per-repo only; global true can leave stale IPC sockets in agent worktrees
	untrackedCache = true # cache untracked scans, the other half of a fast status

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	line-numbers = true
	hyperlinks = true  # OSC 8 file:line links; cmd+click in ghostty opens in $EDITOR

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = zebra
    algorithm = histogram
    context = 5
    mnemonicPrefix = true

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[commit]
	gpgsign = true

# pushInsteadOf, not insteadOf: pushes go over SSH but https clones stay https,
# so go mod download and anonymous fetches of public repos keep working.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[push]
	autoSetupRemote = true
	followTags = true
[pull]
    rebase = true # use rebase instead of merge when pulling changes
[gpg]
	program = /opt/homebrew/bin/gpg

# Work-specific config (URL rewrites, per-dir identity) lives here, untracked.
[include]
	path = ~/.gitconfig.local

[column]
	ui = auto

[fetch]
    prune = true
    prunetags = true
    writeCommitGraph = true  # maintain commit-graph for faster log/blame

[transfer]
    fsckObjects = true  # reject malformed/malicious objects on fetch and push

[rerere]
    enabled = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[maintenance]
    # auto is already true by default. strategy applies to the auto-maintenance
    # that commands trigger on their own, run 'git maintenance start' in a repo
    # to also get the scheduled background jobs.
    strategy = incremental

[branch]
    sort = -committerdate
